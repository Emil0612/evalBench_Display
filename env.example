# Template for the dotenv file python-dotenv reads (copy this file to it and fill in the values).
# The real file is gitignored: never commit a key.

# OpenRouter API key, needed for paid runs only (https://openrouter.ai/keys).
# Analysis, the control models and self-hosted models work without it.
OPENROUTER_API_KEY=

# Optional: keys for self-hosted servers. config/self_hosted.yaml names the variable (api_key_env), never the key.
# VLLM_API_KEY=
